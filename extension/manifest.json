{
  "manifest_version": 3,
  "name": "秋招台账 · 官网采集",
  "version": "0.3.0",
  "description": "用户触发批量核对官网进度，规则失败时按本轮授权截图供 AI 核验。",
  "permissions": ["scripting", "storage", "debugger"],
  "host_permissions": ["http://127.0.0.1/*", "https://*/*", "http://*/*"],
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_idle" }],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "批量核对秋招进度" }
}
